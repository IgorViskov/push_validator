{
  "//A2A": "выход в сеть агентов LLmSeracher; SigningSecret обязан совпадать с её appsettings.json",
  "A2A": {
    "SelfId": "reviewer",
    "HostUrl": "http://localhost:5080",
    "SigningSecret": "dev-shared-secret-for-homework-only",
    "RequireDelegation": true
  },
  "Impact": {
    "Enabled": true,
    "ComplexityThreshold": 4,
    "MaxSymbols": 5,
    "MaxContextChars": 6000,
    "MaxArbiterRetries": 1
  },
  "//Guardrails": "предохранители прогона: превышение любого потолка сворачивает маршрут к отчёту",
  "Guardrails": {
    "Budget": {
      "MaxCostUsd": 0.50,
      "MaxTokens": 400000,
      "MaxDurationSeconds": 900,
      "MaxModelCalls": 12,
      "MaxDelegations": 8
    },
    "Retry": {
      "MaxAttempts": 2,
      "BaseDelayMs": 700
    },
    "CircuitBreaker": {
      "FailureThreshold": 2
    },
    "Tools": {
      "ReadFile": 25,
      "SearchFiles": 15,
      "GitLog": 3,
      "GraphImpact": 5,
      "DeniedFiles": [ "*.pem", "*.key", "*.pfx", "*.p12", "id_rsa*", ".env", ".env.*", "launchSettings.json", "secrets.json", "*.user" ]
    },
    "Output": {
      "MaxFindingsPerStage": 20,
      "MaxMessageChars": 600,
      "VerifyFilePaths": true
    },
    "MetricsPath": "logs"
  },
  "Apis": [
    {
      "Name": "OpenRouter",
      "ApiKey": "",
      "Endpoint": "https://openrouter.ai/api/v1",
      "Models": [
        {
          "Name": "openai/gpt-oss-120b:free",
          "Role": "Orchestration",
          "Priority": 1,
          "CostEfficiency": 4
        },
        {
          "Name": "nvidia/nemotron-3-super-120b-a12b:free",
          "Role": "Execution",
          "Priority": 1,
          "CostEfficiency": 8
        }
      ]
    },
    {
      "Name": "LmStudio",
      "ApiKey": "",
      "Endpoint": "http://localhost:1234/v1",
      "Models": [
        {
          "Name": "qwen/qwen3.6-27b",
          "Role": "Orchestration",
          "Priority": 0,
          "CostEfficiency": 4
        },
        {
          "Name": "openai/gpt-oss-20b",
          "Role": "Execution",
          "Priority": 1,
          "CostEfficiency": 3
        },
        {
          "Name": "zai-org/glm-4.6v-flash",
          "Role": "Validation",
          "Priority": 1,
          "CostEfficiency": 2
        }
      ]
    }
  ]
}
