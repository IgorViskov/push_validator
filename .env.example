# Настройки ReviewAgent для docker compose.
#
#   cp .env.example .env
#
# Каждая переменная перекрывает значение из appsettings.json образа. Файл .env не
# коммитится: в нём адрес модели, ключ и путь к вашим репозиториям.

# ── Порты ────────────────────────────────────────────────────────────────────────
# Порт админки на хосте. Внутри контейнера агент всегда слушает 8080.
AGENT_PORT=8080

# Браузер графа и Bolt. Меняйте, если 7474/7687 уже заняты.
GRAPH_HTTP_PORT=7474
GRAPH_BOLT_PORT=7687

# ── Репозитории ──────────────────────────────────────────────────────────────────
# Каталог хоста, внутри которого лежат обслуживаемые репозитории. Монтируется
# в /repos: репозиторий C:\Projects\my-app при REPOS_ROOT=C:\Projects будет виден
# агенту как /repos/my-app — этот путь и указывается в админке.
#
# Windows: REPOS_ROOT=C:/Projects   (прямые слеши)
# Linux/macOS: REPOS_ROOT=/home/user/projects
REPOS_ROOT=./samples

# ── Хук pre-push ─────────────────────────────────────────────────────────────────
# Адрес агента с точки зрения машины разработчика. Должен совпадать с AGENT_PORT.
HOOK_PUBLIC_URL=http://localhost:8080

# Чем поднимать агента, если он не отвечает. Пустая строка отключает автозапуск.
HOOK_AUTOSTART=docker start review-agent
HOOK_STARTUP_WAIT=90

# Сколько ждать вердикта. Локальная 30B-модель на слабой карте отвечает минутами.
HOOK_TIMEOUT=1200

# Что делать, если агент недоступен: allow — пропустить пуш, block — остановить.
HOOK_ON_UNAVAILABLE=allow

# Разрешать ли продавить пуш: REVIEW_AGENT_FORCE=1 git push
HOOK_ALLOW_FORCE=true

# ── Модели ───────────────────────────────────────────────────────────────────────
# Любой OpenAI-совместимый endpoint. Адрес указывается вместе с версией пути.
#   LM Studio на хосте:  http://host.docker.internal:1234/v1
#   Ollama на хосте:     http://host.docker.internal:11434/v1
#   OpenRouter:          https://openrouter.ai/api/v1
LLM_NAME=LM Studio
LLM_ENDPOINT=http://host.docker.internal:1234/v1

# LM Studio с включённой аутентификацией требует токен (Developer → API tokens).
# Локальные серверы без аутентификации ключ игнорируют — оставьте пустым.
LLM_API_KEY=

LLM_TIMEOUT=900

# Роли. Имена моделей — те, что отдаёт GET /v1/models вашего сервера.
#
#   Orchestration — триаж и арбитраж: короткий ответ строго по схеме, дисциплина
#                   формата важнее глубины.
#   Execution     — анализ диффа в цикле ReAct: нужны понимание кода и вызов
#                   инструментов. Две модели: дешёвая для мелких правок и сильная
#                   для сложных (выбор по CostEfficiency против оценки сложности).
#   Validation    — независимая проверка по тексту диффа: нужна скорость, чтобы
#                   у арбитра было второе мнение.
MODEL_ORCHESTRATION=zai-org/glm-4.6v-flash
MODEL_EXECUTION_CHEAP=openai/gpt-oss-20b
MODEL_EXECUTION=qwen3-coder-30b-a3b-instruct
MODEL_VALIDATION=openai/gpt-oss-20b

# ── Контекст влияния из графа кода ───────────────────────────────────────────────
IMPACT_ENABLED=true
IMPACT_REFRESH=true

# С какой сложности изменений (1..10) идти в граф за вызывающим кодом.
IMPACT_THRESHOLD=3
IMPACT_MAX_CHUNKS=10
IMPACT_MAX_CHARS=6000
IMPACT_ARBITER_RETRIES=1

# ── Предохранители ───────────────────────────────────────────────────────────────
# 0 — не ограничивать. Для локальных моделей стоимость нулевая, ограничивает время.
MAX_COST_USD=0
MAX_TOKENS=400000
MAX_DURATION_SECONDS=1200
MAX_MODEL_CALLS=12
MAX_GRAPH_QUERIES=8
RETRY_ATTEMPTS=2
BREAKER_THRESHOLD=2

# Квоты инструментов на один прогон — от петель в цикле рассуждения.
TOOL_READ_FILE=25
TOOL_SEARCH_FILES=15
TOOL_GIT_LOG=3
TOOL_GRAPH_IMPACT=5

# Потолок витков цикла ReAct в одном обращении к модели. Квоты выше ограничивают работу
# инструментов, но не число обращений: получив отказ «квота исчерпана», модель может
# позвать инструмент снова, и весь цикл при этом укладывается в одно обращение — то есть
# мимо бюджета прогона, который считает обращения.
TOOL_MAX_REACT=6

# Общий потолок вызовов инструментов за прогон. Один виток ReAct — это не один вызов:
# модель вправе запросить десятки инструментов сразу. По исчерпании инструменты бросают
# ошибку, и три ошибки подряд завершают цикл.
TOOL_MAX_TOTAL=60

# Чтение за пределами обслуживаемого репозитория.
TOOL_ALLOW_OUTSIDE=false

# ── Графовая база ────────────────────────────────────────────────────────────────
GRAPH_PASSWORD=review-agent-local
GRAPH_HEAP_MIN=1G
GRAPH_HEAP_MAX=2G
GRAPH_PAGECACHE=1G

# ── Прочее ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=Information
KEEP_RUNS=200
DOTNET_ENVIRONMENT=Production
